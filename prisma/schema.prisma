generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id             Int           @id @default(autoincrement())
  nombre         String
  correo         String        @unique
  contrasenaHash String
  rol            String
  ventas         Venta[]
  carrito        CarritoItem[]
}

model Producto {
  id                Int                @id @default(autoincrement())
  nombre            String
  marca             String?
  categoria         String?
  presentacion      String?
  precio            Decimal?           @db.Decimal(12, 2)
  stock             Int                @default(0)
  vendidos          Int                @default(0)
  imagen            String?
  fecha             DateTime
  detallesVenta     DetalleVenta[]
  detallesRecepcion DetalleRecepcion[]
  carrito           CarritoItem[]
}

model Venta {
  id         Int            @id @default(autoincrement())
  usuarioId  Int?
  usuario    Usuario?       @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  cliente    String
  fecha      DateTime       @default(now())
  total      Decimal        @db.Decimal(12, 2)
  metodoPago String
  estadoPago String
  detalles   DetalleVenta[]
  envio      Envio?
}

model DetalleVenta {
  id             Int      @id @default(autoincrement())
  ventaId        Int
  venta          Venta    @relation(fields: [ventaId], references: [id], onDelete: Restrict)
  productoId     Int
  producto       Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  nombre         String
  precioUnitario Decimal  @db.Decimal(12, 2)
  cantidad       Int
}

model Envio {
  id            Int      @id @default(autoincrement())
  ventaId       Int      @unique
  venta         Venta    @relation(fields: [ventaId], references: [id], onDelete: Restrict)
  nombreCliente String
  direccion     String
  ciudad        String
  telefono      String
  estado        String
  fecha         DateTime
}

model Recepcion {
  id        Int                @id @default(autoincrement())
  fecha     DateTime
  proveedor String
  detalles  DetalleRecepcion[]
}

model DetalleRecepcion {
  id             Int       @id @default(autoincrement())
  recepcionId    Int
  recepcion      Recepcion @relation(fields: [recepcionId], references: [id], onDelete: Restrict)
  productoId     Int
  producto       Producto  @relation(fields: [productoId], references: [id], onDelete: Restrict)
  nombre         String
  cantidad       Int
  estadoProducto String
}

model CarritoItem {
  id         Int      @id @default(autoincrement())
  usuarioId  Int
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  cantidad   Int

  @@unique([usuarioId, productoId])
}
